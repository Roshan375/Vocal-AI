import { GoogleGenAI, Type, Schema } from '@google/genai';

export interface AuditResult {
  metrics: {
    wordCount: number;
    fillerCount: number;
    fillerPercentage: number;
    pacingWPM: number;
    clarityScore: number;
  };
  fillerBreakdown: Array<{ word: string; count: number }>;
  rawTranscript: string;
  refinedScript: string;
  petersonAudit: string;
  screenplayVersion: string;
}

const auditResponseSchema: Schema = {
  type: Type.OBJECT,
  properties: {
    metrics: {
      type: Type.OBJECT,
      properties: {
        wordCount: { type: Type.INTEGER },
        fillerCount: { type: Type.INTEGER },
        fillerPercentage: { type: Type.NUMBER },
        pacingWPM: { type: Type.INTEGER },
        clarityScore: { type: Type.INTEGER },
      },
      required: ['wordCount', 'fillerCount', 'fillerPercentage', 'pacingWPM', 'clarityScore'],
    },
    fillerBreakdown: {
      type: Type.ARRAY,
      items: {
        type: Type.OBJECT,
        properties: {
          word: { type: Type.STRING },
          count: { type: Type.INTEGER },
        },
        required: ['word', 'count'],
      },
    },
    rawTranscript: { type: Type.STRING },
    refinedScript: { type: Type.STRING },
    petersonAudit: { type: Type.STRING },
    screenplayVersion: { type: Type.STRING },
  },
  required: [
    'metrics',
    'fillerBreakdown',
    'rawTranscript',
    'refinedScript',
    'petersonAudit',
    'screenplayVersion',
  ],
};

export async function analyzeAudioWithGemini(audioBuffer: Buffer, mimeType: string = 'audio/wav'): Promise<AuditResult> {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) throw new Error('GEMINI_API_KEY is not defined in environment variables.');

  const ai = new GoogleGenAI({ apiKey });

  const systemInstruction = `
You are VocalRefine AI, an elite multimodal speech coach and vocal dramatist combining exacting linguistic precision with Jordan Peterson's uncompromising rhetorical diagnosis.

Analyze the uploaded speech audio:
1. Transcribe the raw speech verbatim, capturing every stutter, false start, and verbal crutch ("um", "uh", "like", "basically", "you know", "kind of").
2. Calculate exact metrics: word count, total filler count, filler percentage, approximate words-per-minute (pacingWPM), and an overall communication clarity score (0-100).
3. Generate a refined, flawless script: eliminate verbal static, elevate precision, and insert bracket cues such as [pause] where deliberate cadence is required.
4. Provide the "Peterson Audit": Unapologetic, constructive rhetorical feedback analyzing where the speaker lacks conviction, retreats into defensive vagueness, or abdicates intellectual authority.
5. Create a Screenplay Adaptation: Format the refined message into a crisp screenplay scene with scene headings, character names, and parentheticals.
Return output strictly conforming to the requested JSON schema.
`;

  const response = await ai.models.generateContent({
    model: 'gemini-1.5-pro',
    contents: [
      {
        role: 'user',
        parts: [
          {
            inlineData: {
              data: audioBuffer.toString('base64'),
              mimeType: mimeType,
            },
          },
          {
            text: 'Analyze this spoken audio recording according to the system instructions and output valid JSON.',
          },
        ],
      },
    ],
    config: {
      systemInstruction,
      responseMimeType: 'application/json',
      responseSchema: auditResponseSchema,
      temperature: 0.2,
    },
  });

  if (!response.text) {
    throw new Error('Gemini returned an empty response.');
  }

  return JSON.parse(response.text) as AuditResult;
}
