import React, { useState, useRef, useEffect } from 'react';
import { Mic, Square, UploadCloud, RefreshCw } from 'lucide-react';

interface AudioRecorderProps {
  onAudioReady: (blob: Blob) => void;
  title: string;
  subtitle: string;
  minDurationSeconds?: number;
}

export const AudioRecorder: React.FC<AudioRecorderProps> = ({
  onAudioReady,
  title,
  subtitle,
  minDurationSeconds = 1,
}) => {
  const [recording, setRecording] = useState(false);
  const [duration, setDuration] = useState(0);
  const [hasRecorded, setHasRecorded] = useState(false);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);
  const audioChunksRef = useRef<Blob[]>([]);
  const timerRef = useRef<NodeJS.Timeout | null>(null);

  useEffect(() => {
    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, []);

  const startRecording = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorderRef.current = new MediaRecorder(stream);
      audioChunksRef.current = [];

      mediaRecorderRef.current.ondataavailable = (event) => {
        if (event.data.size > 0) audioChunksRef.current.push(event.data);
      };

      mediaRecorderRef.current.onstop = () => {
        const audioBlob = new Blob(audioChunksRef.current, { type: 'audio/webm' });
        onAudioReady(audioBlob);
        setHasRecorded(true);
        stream.getTracks().forEach((track) => track.stop());
      };

      mediaRecorderRef.current.start();
      setRecording(true);
      setDuration(0);

      timerRef.current = setInterval(() => {
        setDuration((prev) => prev + 1);
      }, 1000);
    } catch (err) {
      alert('Microphone access denied or unavailable.');
    }
  };

  const stopRecording = () => {
    if (mediaRecorderRef.current && recording) {
      if (duration < minDurationSeconds) {
        alert(`Recording must be at least ${minDurationSeconds} seconds.`);
        return;
      }
      mediaRecorderRef.current.stop();
      setRecording(false);
      if (timerRef.current) clearInterval(timerRef.current);
    }
  };

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      onAudioReady(file);
      setHasRecorded(true);
    }
  };

  const formatTime = (secs: number) => {
    const mins = Math.floor(secs / 60);
    const remSecs = secs % 60;
    return `${mins}:${remSecs < 10 ? '0' : ''}${remSecs}`;
  };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col items-center">
      <h3 className="text-lg font-bold text-slate-100">{title}</h3>
      <p className="text-xs text-slate-400 text-center mt-1 mb-6">{subtitle}</p>

      {/* Pulsing indicator */}
      <div className="relative mb-6">
        {recording && (
          <span className="absolute -inset-2 rounded-full bg-rose-500/30 animate-ping"></span>
        )}
        <div
          className={`w-24 h-24 rounded-full flex items-center justify-center border-2 transition-all ${
            recording
              ? 'bg-rose-950/40 border-rose-500 text-rose-400'
              : 'bg-slate-800/80 border-slate-700 text-slate-300'
          }`}
        >
          {recording ? (
            <div className="flex flex-col items-center">
              <span className="font-mono text-sm">{formatTime(duration)}</span>
              <span className="text-[10px] uppercase font-bold tracking-widest text-rose-400 mt-1">REC</span>
            </div>
          ) : (
            <Mic className="w-8 h-8 text-indigo-400" />
          )}
        </div>
      </div>

      <div className="flex items-center gap-3 w-full max-w-xs">
        {!recording ? (
          <button
            onClick={startRecording}
            className="flex-1 py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm flex items-center justify-center gap-2 transition"
          >
            <Mic className="w-4 h-4" /> Record Mic
          </button>
        ) : (
          <button
            onClick={stopRecording}
            className="flex-1 py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-medium text-sm flex items-center justify-center gap-2 transition"
          >
            <Square className="w-4 h-4" /> Stop Recording
          </button>
        )}

        <label className="flex items-center justify-center p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 cursor-pointer transition">
          <UploadCloud className="w-4 h-4" />
          <input type="file" accept="audio/*" onChange={handleFileUpload} className="hidden" />
        </label>
      </div>

      {hasRecorded && (
        <span className="text-xs text-emerald-400 font-medium flex items-center gap-1 mt-4">
          <RefreshCw className="w-3 h-3" /> Audio sample captured & ready
        </span>
      )}
    </div>
  );
};
