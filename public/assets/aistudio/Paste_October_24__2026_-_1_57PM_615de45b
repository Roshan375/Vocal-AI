import React, { useState } from 'react';
import axios from 'axios';
import { AudioRecorder } from './components/AudioRecorder';
import { MetricCards } from './components/MetricCards';
import { PetersonAuditCard } from './components/PetersonAuditCard';
import { ScreenplayModal } from './components/ScreenplayModal';
import { AuditResult } from './types';
import { Sparkles, Play, CheckCircle2, Volume2, ShieldAlert, FileText } from 'lucide-react';

const API_BASE = 'http://localhost:5000/api';

export const App: React.FC = () => {
  // Step 1 State: Calibration
  const [modelId, setModelId] = useState<string | null>(null);
  const [isCalibrating, setIsCalibrating] = useState(false);

  // Step 2 State: Audit
  const [auditData, setAuditData] = useState<AuditResult | null>(null);
  const [isAuditing, setIsAuditing] = useState(false);
  const [rawAudioUrl, setRawAudioUrl] = useState<string | null>(null);

  // Step 3 State: Re-Synthesis
  const [isSynthesizing, setIsSynthesizing] = useState(false);
  const [synthesizedAudioUrl, setSynthesizedAudioUrl] = useState<string | null>(null);

  // Modal State
  const [isScreenplayOpen, setIsScreenplayOpen] = useState(false);

  // Step 1: Submit Calibration Voice
  const handleCalibrationAudio = async (blob: Blob) => {
    setIsCalibrating(true);
    try {
      const formData = new FormData();
      formData.append('audio', blob, 'calibration.webm');

      const response = await axios.post(`${API_BASE}/calibrate-voice`, formData);
      setModelId(response.data.modelId);
    } catch (err: any) {
      alert(`Calibration failed: ${err.response?.data?.error || err.message}`);
    } finally {
      setIsCalibrating(false);
    }
  };

  // Step 2: Submit Speech for Analysis
  const handleSpeechAudio = async (blob: Blob) => {
    setIsAuditing(true);
    setRawAudioUrl(URL.createObjectURL(blob));
    setSynthesizedAudioUrl(null);
    try {
      const formData = new FormData();
      formData.append('audio', blob, 'speech.webm');

      const response = await axios.post(`${API_BASE}/audit-speech`, formData);
      setAuditData(response.data.audit);
    } catch (err: any) {
      alert(`Audit failed: ${err.response?.data?.error || err.message}`);
    } finally {
      setIsAuditing(false);
    }
  };

  // Step 3: Trigger Voice Re-Synthesis
  const handleReSynthesize = async () => {
    if (!auditData?.refinedScript || !modelId) return;

    setIsSynthesizing(true);
    try {
      const response = await axios.post(
        `${API_BASE}/resynthesize`,
        {
          script: auditData.refinedScript,
          modelId: modelId,
        },
        { responseType: 'blob' }
      );

      const audioBlob = new Blob([response.data], { type: 'audio/mpeg' });
      setSynthesizedAudioUrl(URL.createObjectURL(audioBlob));
    } catch (err: any) {
      alert(`Synthesis failed: ${err.response?.data?.error || err.message}`);
    } finally {
      setIsSynthesizing(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-indigo-500 selection:text-white">
      {/* Header */}
      <header className="border-b border-slate-800/80 bg-slate-900/50 backdrop-blur sticky top-0 z-40 px-6 py-4 flex justify-between items-center">
        <div className="flex items-center gap-3">
          <div className="p-2 bg-indigo-600 rounded-xl shadow-lg shadow-indigo-500/20">
            <Sparkles className="w-5 h-5 text-white" />
          </div>
          <div>
            <h1 className="font-bold text-lg leading-tight tracking-tight">VocalRefine AI</h1>
            <p className="text-[11px] text-slate-400">Jordan Peterson Rhetoric Coach & Voice Synthesizer</p>
          </div>
        </div>

        <div className="flex items-center gap-3">
          {modelId ? (
            <span className="flex items-center gap-1.5 text-xs bg-emerald-950/70 border border-emerald-800/60 text-emerald-300 px-3 py-1.5 rounded-full font-mono">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" /> Cloned Model: {modelId.slice(0, 8)}...
            </span>
          ) : (
            <span className="flex items-center gap-1.5 text-xs bg-amber-950/70 border border-amber-800/60 text-amber-300 px-3 py-1.5 rounded-full">
              <ShieldAlert className="w-3.5 h-3.5 text-amber-400" /> Voice Not Calibrated
            </span>
          )}
        </div>
      </header>

      {/* Main Container */}
      <main className="flex-1 max-w-6xl w-full mx-auto p-6 space-y-8">
        {/* Step 1 & Step 2 Audio Ingestion */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Step 1: Voice Calibration */}
          <div className="relative">
            <AudioRecorder
              title="Step 1: Voice Calibration"
              subtitle="Record a clean 30s sample to clone your acoustic signature via Fish Audio."
              minDurationSeconds={10}
              onAudioReady={handleCalibrationAudio}
            />
            {isCalibrating && (
              <div className="absolute inset-0 bg-slate-950/80 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center z-10">
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500 mb-2"></div>
                <p className="text-xs font-mono text-indigo-300">Extracting Timbre & Training Model...</p>
              </div>
            )}
          </div>

          {/* Step 2: Speech Audit Recording */}
          <div className="relative">
            <AudioRecorder
              title="Step 2: Spontaneous Speech Capture"
              subtitle="Speak your unfiltered thoughts. Um's, pauses, and crutches will be dissected."
              minDurationSeconds={5}
              onAudioReady={handleSpeechAudio}
            />
            {isAuditing && (
              <div className="absolute inset-0 bg-slate-950/80 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center z-10">
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500 mb-2"></div>
                <p className="text-xs font-mono text-indigo-300">Auditing Vocal Cadence with Gemini 1.5 Pro...</p>
              </div>
            )}
          </div>
        </div>

        {/* Audit Presentation */}
        {auditData && (
          <div className="space-y-6 animate-fade-in">
            {/* Metric Overview Cards */}
            <MetricCards metrics={auditData.metrics} fillerBreakdown={auditData.fillerBreakdown} />

            {/* Jordan Peterson Diagnostic */}
            <PetersonAuditCard auditText={auditData.petersonAudit} />

            {/* Transcript Comparison Section */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {/* Raw Transcript Card */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                <div>
                  <div className="flex justify-between items-center mb-3">
                    <span className="text-xs font-bold uppercase tracking-wider text-rose-400">Verbatim Speech</span>
                    {rawAudioUrl && (
                      <audio controls src={rawAudioUrl} className="h-7 w-48 scale-90" />
                    )}
                  </div>
                  <p className="text-xs text-slate-400 leading-relaxed font-mono bg-slate-950 p-4 rounded-xl border border-slate-800/80 min-h-[140px]">
                    {auditData.rawTranscript}
                  </p>
                </div>
              </div>

              {/* Refined Flawless Script Card */}
              <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                <div>
                  <div className="flex justify-between items-center mb-3">
                    <span className="text-xs font-bold uppercase tracking-wider text-emerald-400">Refined Master Script</span>
                    <button
                      onClick={() => setIsScreenplayOpen(true)}
                      className="text-xs text-indigo-400 hover:text-indigo-300 flex items-center gap-1 transition"
                    >
                      <FileText className="w-3.5 h-3.5" /> Screenplay View
                    </button>
                  </div>
                  <p className="text-xs text-slate-300 leading-relaxed font-mono bg-slate-950 p-4 rounded-xl border border-slate-800/80 min-h-[140px]">
                    {auditData.refinedScript}
                  </p>
                </div>

                {/* Synthesis Trigger */}
                <div className="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
                  <button
                    onClick={handleReSynthesize}
                    disabled={!modelId || isSynthesizing}
                    className={`py-2 px-4 rounded-xl text-xs font-bold flex items-center gap-2 transition ${
                      !modelId
                        ? 'bg-slate-800 text-slate-500 cursor-not-allowed'
                        : isSynthesizing
                        ? 'bg-indigo-900 text-indigo-300'
                        : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30'
                    }`}
                  >
                    {isSynthesizing ? (
                      <span className="flex items-center gap-2">
                        <div className="animate-spin rounded-full h-3 w-3 border-b border-white" /> Synthesizing...
                      </span>
                    ) : (
                      <>
                        <Volume2 className="w-4 h-4" /> Re-Synthesize in Cloned Voice
                      </>
                    )}
                  </button>

                  {synthesizedAudioUrl && (
                    <div className="flex items-center gap-2">
                      <span className="text-[10px] text-emerald-400 font-bold tracking-wider uppercase">Ready:</span>
                      <audio controls autoPlay src={synthesizedAudioUrl} className="h-7 w-48 scale-90" />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Screenplay Adaptation Modal */}
        {auditData && (
          <ScreenplayModal
            isOpen={isScreenplayOpen}
            onClose={() => setIsScreenplayOpen(false)}
            screenplayText={auditData.screenplayVersion}
          />
        )}
      </main>
    </div>
  );
};

export default App;
