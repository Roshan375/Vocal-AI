import express, { Request, Response } from 'express';
import cors from 'cors';
import multer from 'multer';
import dotenv from 'dotenv';
import { normalizeTo16kHzMonoWav } from './services/ffmpegService.js';
import { trainVoiceModel, synthesizeFlawlessSpeech } from './services/fishAudioService.js';
import { analyzeAudioWithGemini } from './services/geminiService.js';

dotenv.config();

const app = express();
const port = process.env.PORT || 5000;
const upload = multer({ storage: multer.memoryStorage(), limits: { fileSize: 25 * 1024 * 1024 } });

app.use(cors());
app.use(express.json());

// Step 1: Voice Calibration & Model Training
app.post('/api/calibrate-voice', upload.single('audio'), async (req: Request, res: Response) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'Audio file is required.' });
    }

    const normalizedWav = await normalizeTo16kHzMonoWav(req.file.buffer);
    const modelId = await trainVoiceModel(normalizedWav, 'UserSpeaker');

    return res.status(200).json({
      success: true,
      modelId,
      message: 'Voice clone model trained and registered successfully.',
    });
  } catch (error: any) {
    console.error('Calibration error:', error);
    return res.status(500).json({ error: error.message || 'Voice calibration failed.' });
  }
});

// Step 2: Speech Recording & Communication Audit
app.post('/api/audit-speech', upload.single('audio'), async (req: Request, res: Response) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'Audio file is required.' });
    }

    const normalizedWav = await normalizeTo16kHzMonoWav(req.file.buffer);
    const auditData = await analyzeAudioWithGemini(normalizedWav, 'audio/wav');

    return res.status(200).json({
      success: true,
      audit: auditData,
    });
  } catch (error: any) {
    console.error('Audit error:', error);
    return res.status(500).json({ error: error.message || 'Speech audit failed.' });
  }
});

// Step 3: Fresh Voice Re-Synthesis
app.post('/api/resynthesize', async (req: Request, res: Response) => {
  try {
    const { script, modelId } = req.body;
    if (!script || !modelId) {
      return res.status(400).json({ error: 'Missing required fields: script and modelId.' });
    }

    const audioBuffer = await synthesizeFlawlessSpeech(script, modelId);

    res.set({
      'Content-Type': 'audio/mpeg',
      'Content-Length': audioBuffer.length,
      'Content-Disposition': 'attachment; filename="refined_voice.mp3"',
    });

    return res.status(200).send(audioBuffer);
  } catch (error: any) {
    console.error('Re-synthesis error:', error);
    return res.status(500).json({ error: error.message || 'Speech re-synthesis failed.' });
  }
});

app.listen(port, () => {
  console.log(`VocalRefine AI backend operational on port ${port}`);
});
