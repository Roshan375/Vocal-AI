Converts arbitrary audio buffers (e.g., browser-recorded .webm or .ogg) into 16 kHz mono .wav normalized for clean acoustic inference and cloning.
code
TypeScript
import ffmpeg from 'fluent-ffmpeg';
import { Readable, PassThrough } from 'stream';

export async function normalizeTo16kHzMonoWav(inputBuffer: Buffer): Promise<Buffer> {
  return new Promise((resolve, reject) => {
    const inputStream = new Readable();
    inputStream.push(inputBuffer);
    inputStream.push(null);

    const outputStream = new PassThrough();
    const chunks: Buffer[] = [];

    outputStream.on('data', (chunk) => chunks.push(chunk));
    outputStream.on('end', () => resolve(Buffer.concat(chunks)));
    outputStream.on('error', (err) => reject(err));

    ffmpeg(inputStream)
      .toFormat('wav')
      .audioChannels(1)
      .audioFrequency(16000)
      .audioCodec('pcm_s16le')
      .on('error', (err) => reject(new Error(`FFmpeg error: ${err.message}`)))
      .pipe(outputStream);
  });
}
